# ==============================================================================
# Fiduciary Mutual Funds Copilot - Environment Variables Template
# Copy this file to .env and fill in your actual API keys
# ==============================================================================

# ---- PRIMARY: Requesty.ai (Tier 0 zero-cost models, mutex serialized) ----
# Get key at: https://requesty.ai/
REQUESTY_API_KEY=your_requesty_key_here

# ---- FALLBACK: OpenRouter (free models; live catalogue discovery) ----
# Get key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here

# ---- OPTIONAL: For advanced features ----
# MF API (NAV data) - free, no key needed for basic usage
# MF_API_BASE_URL=https://api.mfapi.in/mf

# Database (for Option A / API layer) - not needed for Option B Lean
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/mf_copilot
# REDIS_URL=redis://localhost:6379/0